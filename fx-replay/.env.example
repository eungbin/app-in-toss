# ECOS Open API 인증키 (https://ecos.bok.or.kr/api/ 에서 무료 발급)
ECOS_API_KEY=

# 콘솔 광고 그룹 ID.
#   QR 테스트 빌드: ait-ad-test-rewarded-id / ait-ad-test-banner-id
#   출시 빌드:      콘솔에서 발급받은 실 ID (ait.v2.live.*)
# 비우면 광고를 붙이지 않는다. kit 에는 기본값이 없다 —
# 테스트 ID를 상수로 두면 출시 번들에 문자열이 남아 심사에서 반려된다.
VITE_AD_REWARDED_ID=
VITE_AD_BANNER_ID=

# 고객문의 이메일 — 콘솔 '고객문의 이메일' 과 같아야 한다
VITE_SUPPORT_EMAIL=
