# 광고 그룹 ID — 콘솔 → 인앱 광고 → 광고 그룹에서 발급한다.
# 실 ID 는 커밋하지 않는다(.env 는 .gitignore). 비어 있으면 kit 이 테스트 ID 로 돈다.
VITE_AD_REWARDED_ID=
VITE_AD_BANNER_ID=

# 콘솔 "고객문의 이메일" 등록값과 같아야 한다.
VITE_SUPPORT_EMAIL=programmer97@naver.com

# 진단 빌드. 실기기에서만 터지는 문제를 화면에 띄운다.
# 1 로 켜면 check:config --release 와 번들 스캔이 출시 빌드를 막는다.
VITE_DIAG=
